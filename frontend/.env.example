# =========================================================================
# FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# Add these variables to your Vercel Project Settings -> Environment Variables
# =========================================================================

# Frontend Deployed URL on Vercel
VITE_APP_URL=https://your-app-name.vercel.app

# Backend API Base URL on Render
VITE_API_BASE_URL=https://hyperlocal-campaign.onrender.com/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
